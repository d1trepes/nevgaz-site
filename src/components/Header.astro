---
// Шапка: логотип · Услуги ▾ · Цены · Наши работы · О компании · Контакты · «Вызвать мастера».
// Sticky: при скролле вниз прячется, вверх — появляется. «Услуги ▾» — панель с 5 направлениями и фото.
// hero=true — ширина как у хиро на главной (контейнер считается от высоты окна, см. 02-homepage-spec, блок 1).
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { mainNav, services } from '../data/nav';
import company from '../data/company.json';
import { url } from '../lib/url';
import { nb } from '../lib/typo';

interface Props { hero?: boolean }
const { hero = false } = Astro.props;
const items = mainNav.filter((i) => i.header !== false);
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---
<header class:list={['hdr', { 'hdr--hero': hero }]} data-hdr>
  <div class="hdr__in">
    <a class="hdr__logo" href={url('/')} aria-label={`${company.brand} — на главную`}>
      <img src={url('/brand/logo-horizontal.svg')} alt="" width="110" height="34" />
    </a>
    <nav class="hdr__nav" aria-label="Основное меню">
      <ul>
        {items.map((item) => item.children ? (
          <li class="hdr__has-drop">
            <a href={url(item.href)} aria-haspopup="true" aria-expanded="false" class:list={{ 'is-active': isActive(item.href) }} data-drop-toggle>{item.title}</a>
            <div class="drop" data-drop>
              <ul class="drop__grid">
                {item.children.map((s) => (
                  <li>
                    <a class="drop__item" href={url(s.href)}>
                      <span class="drop__ph"><Image src={s.photo} alt="" widths={[240, 480]} sizes="240px" loading="lazy" /></span>
                      <span class="drop__t">{nb(s.title)}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <Button href={url(item.href)} variant="ghost" size="sm" class="drop__all">Все услуги и&nbsp;цены</Button>
            </div>
          </li>
        ) : (
          <li><a href={url(item.href)} class:list={{ 'is-active': isActive(item.href) }}>{item.title}</a></li>
        ))}
      </ul>
    </nav>
    <div class="hdr__right">
      <Button lead size="sm" class="hdr__cta">Вызвать мастера</Button>
      <button class="hdr__burger" type="button" aria-label="Меню" aria-controls="sheet" aria-expanded="false" data-sheet-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="sheet" inert data-sheet>
  <div class="sheet__scrim" data-sheet-close aria-hidden="true"></div>
  <div class="sheet__panel" role="dialog" aria-modal="true" aria-label="Меню" tabindex="-1">
    <div class="sheet__top">
      <a href={url('/')} aria-label={`${company.brand} — на главную`}><img src={url('/brand/logo-horizontal-white.svg')} alt="" width="91" height="28" /></a>
      <button class="sheet__close" type="button" aria-label="Закрыть меню" data-sheet-close>
        <svg width="18" height="18" viewBox="0 0 18 18" stroke="#fff" stroke-width="1.8" aria-hidden="true"><path d="M3 3l12 12M15 3 3 15" /></svg>
      </button>
    </div>
    <nav class="sheet__nav" aria-label="Меню">
      {mainNav.map((i) => i.children ? (
        <div class="sheet__group">
          <a class="sheet__main" href={url(i.href)}>{i.title}</a>
          <ul class="sheet__sub">
            {i.children.map((s) => <li><a href={url(s.href)}>{nb(s.title)}</a></li>)}
          </ul>
        </div>
      ) : (
        <a class="sheet__main" href={url(i.href)}>{i.title}</a>
      ))}
    </nav>
    <div class="sheet__bottom">
      {company.phones.map((p) => <a class="sheet__tel" href={p.href}>{p.display}</a>)}
      <Button lead block>Вызвать мастера</Button>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 30;
    background: rgb(242 241 238 / 0.9);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    transition: transform 0.35s var(--ease-out);
  }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in {
    width: 100%; max-width: var(--container); margin-inline: auto;
    padding: 18px max(calc(var(--gutter) + 4px), env(safe-area-inset-right, 0px)) 18px max(calc(var(--gutter) + 4px), env(safe-area-inset-left, 0px));
    display: flex; align-items: center; gap: 28px;
  }
  .hdr__logo img { height: 34px; width: auto; }

  .hdr__nav { margin-left: 20px; }
  .hdr__nav > ul { display: flex; gap: 28px; font-size: 15px; font-weight: 500; }
  .hdr__nav > ul > li > a { display: block; padding: 6px 0; text-decoration: none; transition: color 0.2s; }
  .hdr__nav a.is-active { color: var(--c-orange-600); }
  .hdr__nav a[aria-haspopup]::after {
    content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 7px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-3px) rotate(45deg); opacity: 0.6; transition: transform 0.25s;
  }
  @media (hover: hover) { .hdr__nav > ul > li > a:hover { color: var(--c-orange-600); } }

  /* выпадающая панель услуг */
  .hdr__has-drop { position: static; }
  .drop {
    position: absolute; left: 50%; top: 100%;
    width: min(100% - 2 * var(--gutter), 1100px);
    background: var(--c-surface); border-radius: var(--r-card); padding: 16px 16px 20px;
    display: grid; gap: 16px;
    opacity: 0; visibility: hidden; transform: translate(-50%, -6px);
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out), visibility 0s 0.25s;
  }
  .drop::before { content: ""; position: absolute; left: 0; right: 0; bottom: 100%; height: 32px; } /* мостик от пункта к панели */
  .hdr__has-drop:hover .drop,
  .hdr__has-drop:focus-within .drop,
  .hdr__has-drop.is-open .drop { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
  .hdr__has-drop:hover > a::after, .hdr__has-drop.is-open > a::after { transform: translateY(0) rotate(225deg); }
  .drop__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .drop__item { display: grid; gap: 10px; text-decoration: none; font-size: 15px; line-height: 1.3; font-weight: 500; }
  .drop__ph { display: block; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; background: var(--c-bg-soft); }
  .drop__ph :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
  .drop__t { padding-inline: 2px; }
  .drop :global(.drop__all) { justify-self: start; background: var(--c-bg); }
  .drop :global(.drop__all .btn__puck) { background: var(--c-surface); }
  @media (hover: hover) { .drop :global(.drop__all:hover .btn__puck) { background: var(--c-orange); color: #fff; } }
  @media (hover: hover) {
    .drop__item:hover .drop__ph :global(img) { transform: scale(1.03); }
    .drop__item:hover .drop__t { color: var(--c-orange-600); }
  }

  .hdr__right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .hdr__burger { display: none; width: 48px; height: 48px; border-radius: 50%; border: 0; background: var(--c-surface); place-items: center; cursor: pointer; }
  .hdr__burger svg { width: 20px; height: 20px; }

  /* мобильное меню: панель справа (~88% ширины), слева видна затемнённая страница */
  .sheet { position: fixed; inset: 0; z-index: 60; visibility: hidden; transition: visibility 0s 0.4s; }
  .sheet.is-open { visibility: visible; transition-delay: 0s; }
  .sheet__scrim { position: absolute; inset: 0; background: rgb(10 26 48 / 0.55); opacity: 0; transition: opacity 0.4s var(--ease-out); }
  .sheet.is-open .sheet__scrim { opacity: 1; }
  .sheet__panel {
    position: absolute; top: 0; right: 0; bottom: 0; width: min(88%, 440px);
    background: var(--c-navy-900); color: #fff;
    display: flex; flex-direction: column; overflow-y: auto; overscroll-behavior: contain;
    padding: calc(env(safe-area-inset-top, 0px) + 12px) max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 20px) 20px;
    border-radius: 20px 0 0 20px;
    transform: translateX(100%); transition: transform 0.4s var(--ease-out);
  }
  .sheet.is-open .sheet__panel { transform: none; }
  .sheet__panel:focus { outline: none; }
  .sheet__top { display: flex; justify-content: space-between; align-items: center; min-height: 48px; }
  .sheet__top img { height: 28px; width: auto; }
  .sheet__close { width: 48px; height: 48px; margin-right: -4px; border-radius: 50%; border: 0; background: rgb(255 255 255 / 0.08); display: grid; place-items: center; cursor: pointer; }
  .sheet__nav { display: grid; margin-top: 20px; }
  .sheet__main {
    display: flex; align-items: center; min-height: 56px; padding-block: 6px;
    font: 600 30px/1.1 var(--f-display); text-decoration: none; border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .sheet__group .sheet__main { border-bottom: 0; }
  .sheet__sub { display: grid; padding-bottom: 10px; border-bottom: 1px solid rgb(255 255 255 / 0.1); }
  .sheet__sub a { display: flex; align-items: center; min-height: 48px; font-size: 16px; line-height: 1.3; color: #c4ccd8; text-decoration: none; }
  .sheet__bottom { margin-top: auto; padding-top: 28px; display: grid; gap: 4px; }
  .sheet__tel { display: flex; align-items: center; min-height: 48px; font: 600 26px/1.1 var(--f-display); text-decoration: none; letter-spacing: 0.01em; }
  /* кнопка всегда видна: прилипает к низу панели, телефоны и пункты прокручиваются над ней */
  .sheet__bottom :global(.btn) {
    position: sticky; bottom: calc(env(safe-area-inset-bottom, 0px) + 20px); margin-top: 24px;
    box-shadow: 0 0 0 20px var(--c-navy-900), 0 60px 0 20px var(--c-navy-900); /* сплошная подложка, не тень */
  }
  @media (hover: hover) { .sheet a:hover { color: var(--c-orange); } }

  @media (max-width: 1080px) {
    .hdr__in { padding-left: max(var(--gutter), env(safe-area-inset-left, 0px)); padding-right: max(var(--gutter), env(safe-area-inset-right, 0px)); }
    .hdr__nav { display: none; }
    .hdr__burger { display: grid; }
  }
  @media (min-width: 1081px) { .sheet { display: none; } }
  @media (max-width: 600px) {
    .hdr__in { padding-block: 12px; }
    .hdr__logo img { height: 28px; }
    .hdr__right :global(.hdr__cta) { display: none; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  if (hdr) {
    // прячем при скролле вниз, показываем при скролле вверх
    let last = window.scrollY;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        const open = hdr.querySelector('.is-open');
        if (y > last && y > 160 && !open) hdr.classList.add('is-hidden');
        else if (y < last - 4 || y < 160) hdr.classList.remove('is-hidden');
        last = y;
        ticking = false;
      });
    }, { passive: true });

    // «Услуги ▾»: на тач-устройствах первый тап открывает панель
    hdr.querySelectorAll<HTMLAnchorElement>('[data-drop-toggle]').forEach((a) => {
      const li = a.parentElement!;
      a.addEventListener('click', (e) => {
        if (window.matchMedia('(hover: hover)').matches) return;
        if (!li.classList.contains('is-open')) { e.preventDefault(); li.classList.add('is-open'); a.setAttribute('aria-expanded', 'true'); }
      });
      li.addEventListener('mouseenter', () => a.setAttribute('aria-expanded', 'true'));
      li.addEventListener('mouseleave', () => { li.classList.remove('is-open'); a.setAttribute('aria-expanded', 'false'); });
      li.addEventListener('keydown', (e) => { if (e.key === 'Escape') { li.classList.remove('is-open'); a.focus(); (document.activeElement as HTMLElement)?.blur(); } });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.hdr__has-drop')) hdr.querySelectorAll('.is-open').forEach((li) => li.classList.remove('is-open'));
    });
  }

  // мобильная шторка
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  const burger = document.querySelector<HTMLButtonElement>('[data-sheet-open]');
  if (sheet && burger) {
    const panel = sheet.querySelector<HTMLElement>('.sheet__panel')!;
    const root = document.documentElement;
    let scrollY = 0;
    // блокировка скролла страницы (в т.ч. iOS Safari): фиксируем body на текущей позиции
    const lock = () => {
      scrollY = window.scrollY;
      const sbw = window.innerWidth - root.clientWidth;
      Object.assign(document.body.style, { position: 'fixed', top: `-${scrollY}px`, left: '0', right: '0', paddingRight: sbw ? `${sbw}px` : '' });
    };
    const unlock = () => {
      Object.assign(document.body.style, { position: '', top: '', left: '', right: '', paddingRight: '' });
      root.style.scrollBehavior = 'auto';
      window.scrollTo(0, scrollY);
      root.style.scrollBehavior = '';
    };
    const isOpen = () => sheet.classList.contains('is-open');
    const open = () => {
      if (isOpen()) return;
      lock();
      sheet.inert = false;
      sheet.classList.add('is-open');
      burger.setAttribute('aria-expanded', 'true');
      panel.focus({ preventScroll: true });
    };
    const close = (restoreFocus = true) => {
      if (!isOpen()) return;
      sheet.classList.remove('is-open');
      sheet.inert = true;
      burger.setAttribute('aria-expanded', 'false');
      unlock();
      if (restoreFocus) burger.focus({ preventScroll: true });
    };
    burger.addEventListener('click', open);
    sheet.querySelectorAll('[data-sheet-close]').forEach((el) => el.addEventListener('click', () => close()));
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'Tab') {
        // фокус не уходит из панели
        const f = [...panel.querySelectorAll<HTMLElement>('a[href], button')];
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && (document.activeElement === first || document.activeElement === panel)) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    // «Вызвать мастера» в меню: закрыть панель, модалку откроет общий обработчик
    sheet.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-lead]')) close(false); });
    // переход по ссылке-якорю или поворот экрана в десктоп — закрыть
    window.matchMedia('(min-width: 1081px)').addEventListener('change', (m) => { if (m.matches) close(false); });
  }
</script>
