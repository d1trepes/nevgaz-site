---
// 11. Контакты — слева адрес, телефоны крупно, email; справа карта 2ГИС, грузится только по клику.
import Button from '../Button.astro';
import company from '../../data/company.json';
import { nb } from '../../lib/typo';
import { url } from '../../lib/url';

const a = company.address;
const street = a.street.replace('улица', 'ул.');
const hasHours = !company.hours.startsWith('TODO');
const landmark = a.landmark.split(',')[0]; // «100 м от ж/д вокзала»
// Виджет 2ГИС не тянется под размер блока и показывает заглушку «отключите VPN», поэтому в блоке —
// карта-виджет Яндекса по координатам из company.json; полная карточка — кнопкой «Открыть в 2ГИС».
const ll = `${a.geo.lon},${a.geo.lat}`;
const widget = `https://yandex.ru/map-widget/v1/?ll=${encodeURIComponent(ll)}&z=17&pt=${encodeURIComponent(ll + ',pm2orm')}`;
---
<section class="section contacts" id="kontakty">
  <div class="container">
    <div class="grid contacts__body reveal">
      <div class="contacts__info">
        <h2>Офис у&nbsp;вокзала<br />в&nbsp;Невинномысске</h2>
        <div class="contacts__item">
          <p class="caption">Адрес</p>
          <p class="contacts__addr">{a.city},<br /><Fragment set:html={nb(street)} /></p>
          <p class="contacts__note" set:html={nb(`${a.note[0].toUpperCase()}${a.note.slice(1)}, ${landmark}.`)} />
        </div>
        {hasHours && (
          <div class="contacts__item">
            <p class="caption">Часы работы</p>
            <p>{company.hours}</p>
          </div>
        )}
        <div class="contacts__item">
          <p class="caption">Телефоны</p>
          {company.phones.map((p) => <a class="contacts__tel" href={p.href}>{p.display}</a>)}
        </div>
        <div class="contacts__item">
          <p class="caption">Почта</p>
          <a class="contacts__mail" href={`mailto:${company.email}`}>{company.email}</a>
        </div>
      </div>

      <div class="map" data-map={widget}>
        <svg class="map__art" viewBox="0 0 800 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g fill="none" stroke="#fff" stroke-linecap="round">
            <path d="M-20 120 L820 210" stroke-width="22" />
            <path d="M-20 380 L820 470" stroke-width="16" />
            <path d="M180 -20 L120 580" stroke-width="14" />
            <path d="M520 -20 L470 580" stroke-width="18" />
            <path d="M-20 260 L820 340" stroke-width="8" />
            <path d="M330 -20 L300 580" stroke-width="8" />
            <path d="M680 -20 L640 580" stroke-width="8" />
          </g>
          <path d="M-20 40 C 200 70, 420 60, 820 20" fill="none" stroke="#c9c4ba" stroke-width="3" stroke-dasharray="14 10" />
        </svg>
        <span class="map__pin" aria-hidden="true"><img src={url('/brand/logo-mark.svg')} alt="" width="40" height="40" /></span>
        <div class="map__cta">
          <Button class="map__btn">Показать карту</Button>
          <Button href={a.map2gis} external variant="ghost">Открыть в&nbsp;2ГИС</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts__body { row-gap: 32px; align-items: stretch; }
  .contacts__info { grid-column: 1 / span 4; display: grid; gap: 28px; align-content: start; }
  .contacts__info h2 { margin-bottom: clamp(4px, 1.2vw, 20px); }
  .contacts__item { display: grid; gap: 6px; padding-top: 18px; border-top: 1px solid var(--c-line); }
  .contacts__addr { font: 600 clamp(26px, 2.2vw, 34px)/1.1 var(--f-display); }
  .contacts__note { color: #3d444e; }
  .contacts__tel { font: 600 clamp(34px, 3vw, 48px)/1.05 var(--f-display); letter-spacing: 0.005em; text-decoration: none; }
  .contacts__mail { font: 600 clamp(26px, 2.2vw, 34px)/1.1 var(--f-display); text-decoration: none; }
  @media (hover: hover) { .contacts__tel:hover, .contacts__mail:hover { color: var(--c-orange-600); } }

  .map {
    grid-column: 6 / -1; position: relative; min-height: clamp(420px, 36vw, 600px);
    border-radius: var(--r-card); overflow: hidden; background: var(--c-bg-soft);
  }
  .map__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map__pin { position: absolute; left: 50%; top: 42%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: #fff; display: grid; place-items: center; }
  .map__pin img { width: 40px; height: 40px; }
  .map__cta { position: absolute; left: 24px; bottom: 24px; right: 24px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map.is-loaded .map__art, .map.is-loaded .map__pin, .map.is-loaded .map__cta { display: none; }

  @media (max-width: 900px) {
    .contacts__info, .map { grid-column: 1 / -1; }
    /* заголовок → карта → адрес, телефоны, почта */
    .contacts__info { display: contents; }
    .contacts__info > * { grid-column: 1 / -1; order: 2; }
    .contacts__info h2 { order: 0; margin-bottom: 0; }
    .map { order: 1; }
    /* высоту задаёт распорка, а не aspect-ratio: Safari схлопывал ячейку без содержимого в 0 */
    .map { min-height: 0; align-self: start; }
    .map::before { content: ""; display: block; padding-top: 75%; }
  }
  @media (min-width: 600px) and (max-width: 1080px) {
    .contacts__tel, .contacts__mail { display: flex; align-items: center; min-height: 48px; width: fit-content; }
  }
  /* телефон: карта 4:5, кнопки друг под другом во всю ширину у нижнего края */
  @media (max-width: 599px) {
    .contacts__body { row-gap: 24px; }
    .contacts__tel, .contacts__mail { display: flex; align-items: center; min-height: 48px; }
    .contacts__tel { font-size: 36px; }
    .map { border-radius: 18px; }
    .map::before { padding-top: 125%; }
    .map__pin { top: 34%; }
    .map__cta { left: 12px; right: 12px; bottom: 12px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('.map__btn')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = map.dataset.map!;
      f.title = 'Карта: офис НевГаз в Невинномысске';
      f.loading = 'lazy';
      map.append(f);
      map.classList.add('is-loaded');
    });
  });
</script>
