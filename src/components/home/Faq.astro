---
// 9. Частые вопросы — аккордеон (колонки 1–8) + карточка «Не нашли ответ?» (10–12). Schema.org FAQPage.
import Button from '../Button.astro';
import company from '../../data/company.json';

const payment = company.payment.map((p, i) => (i ? p.charAt(0).toLowerCase() + p.slice(1) : p)).join(', ');
// «10 000 – 100 000 ₽» → «от 10 000 до 100 000 ₽»
const [gFrom, gTo] = company.prices[0].price.split('–').map((x) => x.trim().replace(/ /g, '&nbsp;'));
const gasRange = gTo ? `от&nbsp;${gFrom.replace('&nbsp;₽', '')} до&nbsp;${gTo}` : gFrom;
const faq = [
  {
    q: 'Сколько стоит провести газ в&nbsp;дом?',
    a: `По&nbsp;нашей странице в&nbsp;2ГИС — ${gasRange}. Цена зависит от&nbsp;длины трассы, газопровода по&nbsp;фасаду и&nbsp;того, что подключаем. Точную сумму называем после выезда и&nbsp;замера.`,
  },
  {
    q: 'Сколько длится монтаж котла?',
    a: 'Зависит от&nbsp;котла, дымохода и&nbsp;обвязки. Срок называем после замера и&nbsp;фиксируем в&nbsp;смете вместе с&nbsp;ценой.',
  },
  {
    q: 'Есть ли гарантия?',
    a: 'Да, на&nbsp;работы даём гарантию. Условия прописываем в&nbsp;договоре.',
  },
  {
    q: 'Можно сделать газ, отопление и&nbsp;воду сразу?',
    a: 'Да, для этого мы&nbsp;и&nbsp;работаем. Газ, котёл, отопление, вода и&nbsp;электрика — одна бригада от&nbsp;проекта до&nbsp;запуска. Не&nbsp;нужно сводить нескольких подрядчиков.',
  },
  {
    q: 'Как оплатить?',
    a: `${payment} — как вам удобнее.`,
  },
  {
    q: 'Выезжаете в&nbsp;район?',
    a: 'Да. Работаем в&nbsp;Невинномысске, выезжаем по&nbsp;Ставропольскому краю и&nbsp;в&nbsp;Черкесск.',
  },
];
const strip = (s: string) => s.replaceAll('&nbsp;', ' ');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: strip(f.q), acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
};
---
<section class="section faq" id="voprosy">
  <div class="container">
    <div class="grid sec-head reveal">
      <h2>Частые вопросы</h2>
    </div>
    <div class="grid faq__body reveal">
      <div class="faq__list">
        {faq.map((f, i) => (
          <details class="qa" open={i === 0}>
            <summary><span set:html={f.q} /><i aria-hidden="true"></i></summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
      <aside class="faq__ask">
        <h3>Не&nbsp;нашли ответ?</h3>
        <p>Спросите мастера напрямую — перезвоним и&nbsp;ответим по&nbsp;вашему дому.</p>
        <Button lead topic="вопрос мастеру">Задать вопрос</Button>
      </aside>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq__body { align-items: start; row-gap: 32px; }
  .faq__list { grid-column: 1 / span 8; border-top: 1px solid var(--c-line); }
  .qa { border-bottom: 1px solid var(--c-line); }
  .qa summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 24px 0; cursor: pointer; list-style: none;
    font: 600 clamp(22px, 1.8vw, 28px)/1.15 var(--f-display);
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary i { position: relative; flex: none; width: 18px; height: 18px; }
  .qa summary i::before, .qa summary i::after { content: ""; position: absolute; left: 0; top: 8px; width: 18px; height: 1.6px; background: currentColor; transition: transform 0.3s var(--ease-out); }
  .qa summary i::after { transform: rotate(90deg); }
  .qa[open] summary i::after { transform: rotate(0deg); }
  @media (hover: hover) { .qa summary:hover { color: var(--c-orange-600); } }
  .qa p { padding: 0 64px 26px 0; font-size: 17px; color: #3d444e; max-width: 70ch; }

  .faq__ask {
    grid-column: 10 / -1; background: var(--c-surface); border-radius: var(--r-card);
    padding: clamp(24px, 2.2vw, 32px); display: grid; gap: 14px; justify-items: start;
  }
  .faq__ask h3 { font-size: clamp(28px, 2.2vw, 34px); font-weight: 700; }
  .faq__ask p { font-size: 16px; color: #3d444e; margin-bottom: 8px; }

  @media (max-width: 1080px) { .faq__list { grid-column: 1 / -1; } .faq__ask { grid-column: 1 / span 6; } }
  @media (max-width: 600px) { .faq__ask { grid-column: 1 / -1; } .qa p { padding-right: 0; } }
</style>
