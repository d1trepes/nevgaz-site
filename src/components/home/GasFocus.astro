---
// 4. Газификация частного дома — ref-05 bento: большое фото с заголовком, белая карточка, два фото с объектов.
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import dusk from '../../assets/ai/house-dusk.jpg';
import warn from '../../assets/photos/06-gas-pipe-warning-box.jpg';
import meter from '../../assets/photos/09-gas-meter-brick.jpg';

const points = [
  'Трасса от&nbsp;точки подключения на&nbsp;участке',
  'Газопровод по&nbsp;фасаду и&nbsp;ввод в&nbsp;дом',
  'Счётчик, кран, подключение плиты и&nbsp;котла',
  'Первый пуск и&nbsp;сдача газовой службе',
];
---
<section class="section gas" id="gazifikaciya">
  <div class="container grid gas__grid reveal">
    <div class="gas__hero">
      <Image class="gas__hero-img" src={dusk} alt="Кирпичный дом вечером, свет в окнах, газовая труба по фасаду" widths={[768, 1080, 1440]} sizes="(min-width: 1081px) 58vw, 100vw" loading="lazy" />
      <h2>Газ в&nbsp;дом —<br />без беготни</h2>
    </div>

    <div class="gas__card">
      <div class="gas__text">
      <p class="gas__lead">Подведём газ от&nbsp;точки на&nbsp;участке до&nbsp;плиты и&nbsp;котла: трасса, фасадный газопровод, счётчик, подключение оборудования, первый пуск.</p>
      <ul class="gas__list">
        {points.map((p) => (
          <li>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
            <span set:html={p} />
          </li>
        ))}
      </ul>
      </div>
      <Button lead topic="газификация дома">Узнать стоимость газификации</Button>
    </div>

    <figure class="gas__ph">
      <Image src={warn} alt="Газовая труба и жёлтый ящик с надписью «Огнеопасно газ» на стене" widths={[320, 640]} sizes="(min-width: 1081px) 20vw, 50vw" loading="lazy" />
    </figure>
    <figure class="gas__ph">
      <Image src={meter} alt="Газопровод и счётчик у кирпичной стены" widths={[320, 640]} sizes="(min-width: 1081px) 20vw, 50vw" loading="lazy" />
    </figure>
  </div>
</section>

<style>
  .gas__grid { grid-template-rows: auto auto; row-gap: var(--gap); }
  .gas__hero {
    grid-column: 1 / span 7; grid-row: 1 / span 2; position: relative; min-height: 560px;
    border-radius: var(--r-card); overflow: hidden; display: flex; align-items: flex-end; isolation: isolate;
  }
  .gas__hero :global(.gas__hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; z-index: -2; }
  .gas__hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(10 26 48 / 0.82) 0%, rgb(10 26 48 / 0.3) 38%, rgb(10 26 48 / 0) 60%); }
  .gas__hero h2 { color: #fff; padding: clamp(24px, 3vw, 44px); font-size: clamp(44px, 5.6vw, 88px); line-height: 0.95; }

  .gas__card {
    grid-column: 8 / -1; background: var(--c-surface); border-radius: var(--r-card);
    padding: clamp(24px, 2.6vw, 40px); display: grid; gap: 24px; justify-items: start; align-content: start;
  }
  .gas__text { display: contents; }
  .gas__lead { font-size: 18px; line-height: 1.55; }
  .gas__list { display: grid; gap: 0; width: 100%; border-top: 1px solid var(--c-line); }
  .gas__list li { display: flex; gap: 12px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid var(--c-line); font-size: 16px; }
  .gas__list svg { width: 16px; height: 16px; flex: none; color: var(--c-orange-600); transform: translateY(2px); }

  .gas__ph { margin: 0; display: grid; gap: 10px; align-content: start; }
  .gas__ph:nth-of-type(1) { grid-column: 8 / span 3; }
  .gas__ph:nth-of-type(2) { grid-column: 11 / span 2; }
  .gas__ph :global(img) { width: 100%; height: clamp(180px, 15vw, 260px); object-fit: cover; border-radius: var(--r-photo); }

  @media (max-width: 1080px) {
    .gas__hero { grid-column: 1 / -1; grid-row: auto; min-height: 460px; }
    .gas__card { grid-column: 1 / -1; }
    .gas__ph:nth-of-type(1) { grid-column: 1 / span 6; }
    .gas__ph:nth-of-type(2) { grid-column: 7 / span 6; }
  }
  /* телефон: фото с заголовком → белая карточка → кнопка во всю колонку → два фото 1:1 */
  @media (max-width: 599px) {
    .gas__grid { row-gap: 12px; }
    .gas__hero { min-height: 0; aspect-ratio: 4 / 5; border-radius: 20px; }
    .gas__hero h2 { padding: 20px; font-size: clamp(40px, 11vw, 48px); }
    .gas__card { display: contents; }
    .gas__text { display: grid; gap: 20px; grid-column: 1 / -1; padding: 24px 20px 12px; background: var(--c-surface); border-radius: 18px; }
    .gas__card :global(.btn) { grid-column: 1 / -1; }
    .gas__lead { font-size: 17px; }
    .gas__list { border-top: 0; }
    .gas__list li:last-child { border-bottom: 0; }
    .gas__ph { margin-top: 4px; }
    .gas__ph:nth-of-type(1) { grid-column: 1 / span 6; }
    .gas__ph:nth-of-type(2) { grid-column: 7 / span 6; }
    .gas__ph :global(img) { height: auto; aspect-ratio: 1; border-radius: 14px; }
  }
</style>
