---
// 3. Как мы работаем — ref-04: нумерованный список с тонкими линиями + большое фото, меняется по шагам.
import { Image } from 'astro:assets';
import request from '../../assets/ai/step-request.jpg';
import meter from '../../assets/ai/meter-check.jpg';
import estimate from '../../assets/ai/step-estimate.jpg';
import install from '../../assets/ai/step-install.jpg';
import flame from '../../assets/ai/flame-macro.jpg';

const steps = [
  { t: 'Заявка', d: 'Звоните или&nbsp;оставляете номер — перезваниваем.', photo: request, pos: '50% 50%', alt: 'Хозяин дома звонит мастеру, на&nbsp;столе план дома' },
  { t: 'Выезд и&nbsp;замер', d: 'Мастер приезжает на&nbsp;объект, смотрит дом и&nbsp;сети.', photo: meter, pos: '50% 50%', alt: 'Мастер проверяет газовый счётчик на&nbsp;фасаде' },
  { t: 'Смета', d: 'Подбираем оборудование под дом и&nbsp;бюджет, фиксируем цену.', photo: estimate, pos: '50% 50%', alt: 'Смета, калькулятор, рулетка и&nbsp;образцы крана и&nbsp;трубы на&nbsp;столе' },
  { t: 'Монтаж', d: 'Своя бригада, без субподрядчиков.', photo: install, pos: '50% 50%', alt: 'Мастер затягивает газовый кран на&nbsp;жёлтой трубе' },
  { t: 'Запуск', d: 'Пусконаладка, сдача газовой службе, гарантия.', photo: flame, pos: '50% 50%', alt: 'Синее пламя газовой горелки котла' },
];
const plain = (s: string) => s.replaceAll('&nbsp;', ' ');
---
<section class="section process" id="kak-rabotaem">
  <div class="container">
    <div class="grid sec-head reveal">
      <h2>Один подрядчик —<br />от&nbsp;замера до&nbsp;тепла&nbsp;в&nbsp;доме</h2>
    </div>
    <div class="grid process__body reveal" data-steps>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class:list={{ 'is-open': i === 0 }}>
            <button type="button" class:list={['step', { 'is-active': i === 0 }]} data-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="step__t" set:html={s.t} />
              <span class="step__d" set:html={s.d} />
            </button>
            <div class="step__more" aria-hidden={i === 0 ? undefined : 'true'}>
              <div class="step__more-in">
                <p set:html={s.d} />
                <Image src={s.photo} alt={plain(s.alt)} widths={[480, 768, 1080]} sizes="(min-width: 901px) 1px, 100vw" loading="lazy" style={`object-position:${s.pos}`} />
              </div>
            </div>
          </li>
        ))}
      </ol>
      <div class="process__photo">
        {steps.map((s, i) => (
          <Image class:list={['process__img', { 'is-active': i === 0 }]} data-photo={i} src={s.photo} alt={plain(s.alt)}
            widths={[640, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" style={`object-position:${s.pos}`} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .process__body { align-items: stretch; }
  .steps { grid-column: 1 / span 6; border-top: 1px solid var(--c-line); }
  .steps li { border-bottom: 1px solid var(--c-line); }
  .step {
    width: 100%; display: grid; grid-template-columns: 72px 1fr; column-gap: 16px; row-gap: 4px; align-items: baseline;
    padding: 26px 8px 26px 0; border: 0; background: none; text-align: left; cursor: pointer; color: var(--c-muted);
    transition: color 0.3s;
  }
  .step__n { grid-row: span 2; font: 600 20px/1 var(--f-display); letter-spacing: 0.02em; }
  .step__t { font: 700 clamp(28px, 2.6vw, 40px)/1 var(--f-display); }
  .step__d { font-size: 16px; line-height: 1.5; }
  .step.is-active { color: var(--c-ink); }
  .step.is-active .step__n { color: var(--c-orange-600); }
  .step.is-active .step__d { color: #3d444e; }
  @media (hover: hover) { .step:hover { color: var(--c-ink); } }

  .process__photo { grid-column: 7 / -1; position: relative; border-radius: var(--r-card); overflow: hidden; background: var(--c-bg-soft); min-height: 420px; }
  .process__photo :global(.process__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .process__photo :global(.process__img.is-active) { opacity: 1; }

  .step__more { display: none; }

  /* мобилка/планшет: аккордеон — по тапу на шаг под ним выезжают пояснение и фото */
  @media (max-width: 900px) {
    .steps { grid-column: 1 / -1; }
    .process__photo { display: none; }
    .step { align-items: center; }
    .step__d { display: none; }
    .step::after {
      content: ""; grid-column: 3; grid-row: 1; width: 10px; height: 10px; margin-right: 6px;
      border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
      transform: translateY(-3px) rotate(45deg); transition: transform 0.35s var(--ease-out);
    }
    .step { grid-template-columns: 72px 1fr auto; }
    .step.is-active::after { transform: translateY(2px) rotate(225deg); }
    .step__more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.45s var(--ease-out); }
    .step__more-in { min-height: 0; overflow: hidden; display: grid; gap: 16px; padding-left: 88px; }
    .step__more-in p { font-size: 16px; line-height: 1.5; color: #3d444e; }
    .step__more-in :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-photo); margin-bottom: 24px; }
    li.is-open .step__more { grid-template-rows: 1fr; }
  }
  @media (max-width: 599px) {
    .step__more-in { padding-left: 0; gap: 14px; }
    .step__more-in :global(img) { border-radius: 14px; margin-bottom: 20px; }
    .step { grid-template-columns: 40px 1fr auto; column-gap: 8px; padding: 18px 0; min-height: 48px; }
    .step__n { font-size: 18px; }
    .step__t { font-size: 28px; }
    .step__d { font-size: 15px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-step]');
    const photos = root.querySelectorAll<HTMLElement>('[data-photo]');
    const show = (i: string) => {
      btns.forEach((b) => { const on = b.dataset.step === i; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
      photos.forEach((p) => p.classList.toggle('is-active', p.dataset.photo === i));
      btns.forEach((b) => {
        const li = b.parentElement!; const on = b.dataset.step === i;
        li.classList.toggle('is-open', on);
        const more = li.querySelector<HTMLElement>('.step__more');
        if (more) { if (on) more.removeAttribute('aria-hidden'); else more.setAttribute('aria-hidden', 'true'); }
      });
    };
    btns.forEach((b) => {
      const desk = () => window.matchMedia('(min-width: 901px)').matches;
      b.addEventListener('mouseenter', () => { if (desk()) show(b.dataset.step!); });
      b.addEventListener('focus', () => { if (desk()) show(b.dataset.step!); });
      b.addEventListener('click', () => {
        // мобилка: повторный тап по открытому шагу закрывает его
        const li = b.parentElement!;
        if (!desk() && li.classList.contains('is-open')) {
          li.classList.remove('is-open'); b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
          li.querySelector('.step__more')?.setAttribute('aria-hidden', 'true');
          return;
        }
        show(b.dataset.step!);
      });
    });
  });
</script>
