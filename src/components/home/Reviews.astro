---
// 8. Отзывы — три белые карточки: текст крупно, имя и дата мелко. Рейтинг только в шапке секции.
import Arrow from '../Arrow.astro';
import company from '../../data/company.json';
import { nb } from '../../lib/typo';

// В демо — пересказ из company.json (без служебной пометки). Дословные тексты — после согласия клиента.
const clean = (t: string) => {
  const s = t.replace(/^[A-Z/\-]+TODO:\s*/, '').trim();
  return nb(s.charAt(0).toUpperCase() + s.slice(1));
};
const fmt = (d: string) => new Date(d).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).replace(' г.', '');
const rating = company.rating.value.toFixed(1).replace('.', ',');
const reviewsUrl = `${company.address.map2gis}/tab/reviews`;
---
<section class="section reviews" id="otzyvy">
  <div class="container">
    <div class="grid sec-head reveal">
      <h2>Что говорят клиенты</h2>
      <div class="sec-head__aside reviews__aside">
        <p class="reviews__rating"><span>{rating}</span> на&nbsp;{company.rating.source}</p>
        <a class="link-arrow" href={reviewsUrl} target="_blank" rel="noopener">Все отзывы на&nbsp;2ГИС<Arrow /></a>
      </div>
    </div>
    <ul class="grid reviews__grid reveal">
      {company.reviews.map((r) => (
        <li class="review">
          <p class="review__text">{clean(r.text)}</p>
          <p class="review__meta">{r.author}<span aria-hidden="true"> · </span><time datetime={r.date}>{fmt(r.date)}</time></p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews__aside { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .reviews__rating { font-size: 18px; color: var(--c-ink); }
  .reviews__rating span { font: 600 clamp(48px, 4.4vw, 72px)/0.9 var(--f-display); margin-right: 6px; }
  .reviews__aside .link-arrow { color: var(--c-ink); margin-bottom: 6px; }

  .reviews__grid { row-gap: var(--gap); }
  .review {
    grid-column: span 4; display: flex; flex-direction: column; gap: 28px; justify-content: space-between;
    min-height: 260px; padding: clamp(24px, 2.4vw, 36px); background: var(--c-surface); border-radius: var(--r-card);
  }
  .review__text { font-size: 18px; line-height: 1.55; }
  .review__meta { font-size: 14px; color: var(--c-muted); }

  @media (max-width: 900px) { .review { grid-column: 1 / -1; min-height: 0; } }
</style>
